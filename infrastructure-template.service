[Unit]
Description=infrastructure-template
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
User=root
Group=root
RestartSec=5
Restart=on-failure
WorkingDirectory=/opt/infrastructure-template
ExecStart=/opt/infrastructure-template/infrastructure-template.mjs
EnvironmentFile=/opt/infrastructure-template/.env

[Install]
WantedBy=multi-user.target
