{
  "name": "@eliware/infrastructure-template",
  "type": "module",
  "version": "9.0.0",
  "description": "An Eliware infrastructure repository template for desired state, validation, rollout, and rollback boundaries.",
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/infrastructure-template.git"
  },
  "keywords": [
    "infrastructure-template",
    "infrastructure",
    "nodejs",
    "starter",
    "template"
  ],
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "26"
  },
  "eliware": {
    "apply": [
      "general",
      "infrastructure",
      "private"
    ]
  },
  "bugs": {
    "url": "https://github.com/eliware/infrastructure-template/issues"
  },
  "homepage": "https://github.com/eliware/infrastructure-template#readme",
  "devDependencies": {
    "@eliware/test": "^9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  }
}
